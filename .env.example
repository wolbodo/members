# Database (postgres-js connection string)
DATABASE_URL=postgres://members:members@localhost:5432/members

# JWT signing key
HASURA_SECRET_KEY=your-secret-key-here

# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Email (nodemailer)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=false

# Mercure (optional, only for /auth/mercure endpoint)
MERCURE_JWT_SECRET=your-mercure-secret
MERCURE_DOMAIN=localhost
