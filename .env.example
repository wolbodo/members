# Database
DATABASE_URL=postgres://members:members@localhost:5432/members

# JWT signing key
JWT_SECRET=your-secret-key-here

# Cookie settings
COOKIE_DOMAIN=wolbodo.nl
COOKIE_SECURE=true

# Email (nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=false

# Mercure (optional, only for /auth/mercure endpoint)
MERCURE_JWT_SECRET=your-mercure-secret
MERCURE_DOMAIN=wolbodo.nl
